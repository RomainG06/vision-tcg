# Database
DB_PATH=./dev.db

# Chromium
CHROMIUM_WS=ws://localhost:3001
CHROMIUM_HEADLESS=false

# Scraping
MAX_RESULTS=50
SCRAPE_TIMEOUT=60000

# Scoring
MAX_BUDGET=1500
TARGET_LAT=43.7102
TARGET_LON=7.2620
MAX_DISTANCE_KM=50

# API
PORT=3000
NODE_ENV=development
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
