{
  "name": "vision-tcg-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API pour détection et scoring de lots de cartes Pokémon",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "node --watch src/api/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint src/",
    "db:migrate": "node src/db/migrate-cli.js",
    "db:seed": "node src/db/seed-cli.js",
    "resolve:captcha": "node resolve-captcha.js",
    "scrape:test": "node test-scraping.js leboncoin",
    "scrape:lbc": "node test-scraping.js leboncoin --save",
    "scrape:vinted": "node test-scraping.js vinted --save",
    "scrape:all": "node test-scraping.js all --save"
  },
  "keywords": [
    "pokemon",
    "tcg",
    "scraper",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsdom": "^23.0.1",
    "puppeteer": "^21.7.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
