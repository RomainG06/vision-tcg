{
  "name": "vision-tcg-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Vision TCG - Pokemon card lot detection and prioritization",
  "scripts": {
    "dev": "cross-env PORT=3001 node --watch src/api/server.js",
    "start": "node src/api/server.js",
    "db:seed": "node src/db/seed.js",
    "db:seed-keywords": "node seed-keywords.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "db:migrate": "node src/db/migrations.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "puppeteer": "^21.9.0",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}