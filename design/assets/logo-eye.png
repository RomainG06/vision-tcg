<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges" width="64" height="64">
  <!-- Minimal PNG-style representation (raster simulation) -->
  <!-- Background -->
  <rect width="64" height="64" fill="#1A1A1A"/>
  
  <!-- Eye sclera -->
  <circle cx="32" cy="32" r="18" fill="#F5F5F5"/>
  
  <!-- Iris -->
  <circle cx="32" cy="32" r="12" fill="#0B3D91"/>
  
  <!-- Pupil -->
  <circle cx="32" cy="32" r="6" fill="#050A2E"/>
  
  <!-- Highlight -->
  <circle cx="28" cy="28" r="2" fill="#39A0A6"/>
  
  <!-- Outer ring -->
  <circle cx="32" cy="32" r="18" fill="none" stroke="#5A1F1F" stroke-width="2"/>
</svg>
