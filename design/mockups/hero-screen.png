<svg viewBox="0 0 375 812" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
  <!-- Mobile frame background -->
  <rect width="375" height="812" fill="#1A1A1A"/>
  
  <!-- Status bar -->
  <rect x="0" y="0" width="375" height="40" fill="#0B3D91"/>
  <text x="10" y="25" font-family="Arial, sans-serif" font-size="12" fill="#F5F5F5">09:41</text>
  
  <!-- Header -->
  <rect x="0" y="40" width="375" height="60" fill="#0B3D91" stroke="#D4AF37" stroke-width="1"/>
  <circle cx="25" cy="70" r="15" fill="#F5F5F5" stroke="#D4AF37" stroke-width="1"/>
  <circle cx="25" cy="70" r="10" fill="#0B3D91"/>
  <circle cx="25" cy="70" r="5" fill="#050A2E"/>
  <text x="50" y="75" font-family="Courier New, monospace" font-size="14" font-weight="bold" fill="#D4AF37">Vision TCG</text>
  
  <!-- Search bar -->
  <rect x="10" y="110" width="355" height="35" fill="#333333" stroke="#555555" stroke-width="1"/>
  <text x="20" y="132" font-family="Arial, sans-serif" font-size="12" fill="#888888">Rechercher...</text>
  
  <!-- Filters -->
  <text x="15" y="160" font-family="Arial, sans-serif" font-size="11" font-weight="bold" fill="#D4AF37">Filtres rapides</text>
  <rect x="15" y="165" width="85" height="25" fill="#47562B" stroke="#D4AF37" stroke-width="1"/>
  <text x="25" y="182" font-family="Arial, sans-serif" font-size="10" fill="#D4AF37">☑ Cartes</text>
  
  <rect x="105" y="165" width="85" height="25" fill="#47562B" stroke="#333333" stroke-width="1"/>
  <text x="115" y="182" font-family="Arial, sans-serif" font-size="10" fill="#F5F5F5">Accessoires</text>
  
  <rect x="195" y="165" width="85" height="25" fill="#47562B" stroke="#333333" stroke-width="1"/>
  <text x="205" y="182" font-family="Arial, sans-serif" font-size="10" fill="#F5F5F5">Decks</text>
  
  <rect x="285" y="165" width="85" height="25" fill="#47562B" stroke="#333333" stroke-width="1"/>
  <text x="295" y="182" font-family="Arial, sans-serif" font-size="10" fill="#F5F5F5">Autre</text>
  
  <!-- Card 1 -->
  <rect x="15" y="200" width="345" height="170" fill="#333333" stroke="#D4AF37" stroke-width="1"/>
  <rect x="20" y="205" width="335" height="35" fill="#0B3D91"/>
  <text x="30" y="227" font-family="Courier New, monospace" font-size="12" fill="#D4AF37">Charizard Ex</text>
  <rect x="20" y="245" width="335" height="90" fill="#1A1A1A" stroke="#555555" stroke-width="1"/>
  <text x="187" y="290" font-family="Arial, sans-serif" font-size="11" fill="#888888" text-anchor="middle">[Image]</text>
  <text x="30" y="345" font-family="Courier New, monospace" font-size="11" fill="#D4AF37">150€ • 📍 Paris</text>
  <circle cx="345" cy="240" r="8" fill="#F5F5F5" stroke="#D4AF37" stroke-width="1"/>
  
  <!-- Card 2 -->
  <rect x="15" y="380" width="345" height="170" fill="#333333" stroke="#D4AF37" stroke-width="1"/>
  <rect x="20" y="385" width="335" height="35" fill="#5A1F1F"/>
  <text x="30" y="407" font-family="Courier New, monospace" font-size="12" fill="#D4AF37">Blastoise</text>
  <rect x="20" y="425" width="335" height="90" fill="#1A1A1A" stroke="#555555" stroke-width="1"/>
  <text x="187" y="470" font-family="Arial, sans-serif" font-size="11" fill="#888888" text-anchor="middle">[Image]</text>
  <text x="30" y="525" font-family="Courier New, monospace" font-size="11" fill="#D4AF37">200€ • 📍 Lyon</text>
  <circle cx="345" cy="420" r="8" fill="#F5F5F5" stroke="#D4AF37" stroke-width="1"/>
  
  <!-- Card 3 -->
  <rect x="15" y="560" width="345" height="170" fill="#333333" stroke="#D4AF37" stroke-width="1"/>
  <rect x="20" y="565" width="335" height="35" fill="#0B3D91"/>
  <text x="30" y="587" font-family="Courier New, monospace" font-size="12" fill="#D4AF37">Dragonite</text>
  <rect x="20" y="605" width="335" height="90" fill="#1A1A1A" stroke="#555555" stroke-width="1"/>
  <text x="187" y="650" font-family="Arial, sans-serif" font-size="11" fill="#888888" text-anchor="middle">[Image]</text>
  <text x="30" y="705" font-family="Courier New, monospace" font-size="11" fill="#D4AF37">175€ • 📍 Marseille</text>
  
  <!-- Bottom nav -->
  <rect x="0" y="770" width="375" height="42" fill="#47562B" stroke="#333333" stroke-width="1"/>
  <text x="50" y="795" font-family="Arial, sans-serif" font-size="12" fill="#D4AF37" text-anchor="middle">🏠 Accueil</text>
  <text x="187" y="795" font-family="Arial, sans-serif" font-size="12" fill="#F5F5F5" text-anchor="middle">🔍 Recherche</text>
  <text x="325" y="795" font-family="Arial, sans-serif" font-size="12" fill="#F5F5F5" text-anchor="middle">👤 Profil</text>
</svg>
